{
  "name": "@hesdor/workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open-source, local-first AI software engineering CLI",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:replay": "vitest run packages/agent-core/src/testing packages/providers/src/sse-fixtures.test.ts",
    "bench": "node scripts/bench.mjs",
    "lint": "oxlint packages"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "oxlint": "^1.3.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.4"
  }
}
