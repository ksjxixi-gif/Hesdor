{
  "name": "cancel-mid-batch",
  "description": "Two writes in one turn; the user cancels after the first. The second must not run and still gets a tool result.",
  "interactions": [
    {
      "match": { "role": "user" },
      "chunks": [
        { "type": "tool_call", "index": 0, "id": "c1", "name": "write_file", "argumentsDelta": "{\"path\":\"a.txt\",\"content\":\"A\\n\"}" },
        { "type": "tool_call", "index": 1, "id": "c2", "name": "write_file", "argumentsDelta": "{\"path\":\"b.txt\",\"content\":\"B\\n\"}" },
        { "type": "finish", "reason": "tool_calls" }
      ]
    }
  ]
}
