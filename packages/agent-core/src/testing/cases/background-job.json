{
  "name": "background-job",
  "description": "Starts a dev server as a background job, reads its output, stops it.",
  "interactions": [
    {
      "match": { "role": "user" },
      "chunks": [
        { "type": "tool_call", "index": 0, "id": "c1", "name": "run_command", "argumentsDelta": "{\"command\":\"node server.js\",\"background\":true}" },
        { "type": "finish", "reason": "tool_calls" }
      ]
    },
    {
      "match": { "role": "tool_result", "toolCallId": "c1", "contains": ["job_id: job1", "status: running", "ready"] },
      "chunks": [
        { "type": "tool_call", "index": 0, "id": "c2", "name": "job_output", "argumentsDelta": "{\"job_id\":\"job1\",\"wait_ms\":2000}" },
        { "type": "finish", "reason": "tool_calls" }
      ]
    },
    {
      "match": { "role": "tool_result", "toolCallId": "c2", "contains": ["tick"] },
      "chunks": [
        { "type": "tool_call", "index": 0, "id": "c3", "name": "job_stop", "argumentsDelta": "{\"job_id\":\"job1\"}" },
        { "type": "finish", "reason": "tool_calls" }
      ]
    },
    {
      "match": { "role": "tool_result", "toolCallId": "c3", "contains": ["stopped: true", "status: exited"] },
      "chunks": [
        { "type": "text", "text": "The server started, ticked, and is stopped now." },
        { "type": "finish", "reason": "stop" }
      ]
    }
  ]
}
