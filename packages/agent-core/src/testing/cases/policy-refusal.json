{
  "name": "policy-refusal",
  "description": "rm -rf is blocked without approval; the model recovers with delete_file.",
  "interactions": [
    {
      "match": { "role": "user" },
      "chunks": [
        { "type": "tool_call", "index": 0, "id": "c1", "name": "run_command", "argumentsDelta": "{\"command\":\"rm -rf build\"}" },
        { "type": "finish", "reason": "tool_calls" }
      ]
    },
    {
      "match": { "role": "tool_result", "toolCallId": "c1", "contains": ["blocked"] },
      "chunks": [
        { "type": "text", "text": "Shell deletes need approval; using delete_file instead." },
        { "type": "tool_call", "index": 0, "id": "c2", "name": "delete_file", "argumentsDelta": "{\"path\":\"build/out.txt\"}" },
        { "type": "finish", "reason": "tool_calls" }
      ]
    },
    {
      "match": { "role": "tool_result", "toolCallId": "c2", "contains": ["deleted: true"] },
      "chunks": [
        { "type": "text", "text": "Removed build/out.txt." },
        { "type": "finish", "reason": "stop" }
      ]
    }
  ]
}
