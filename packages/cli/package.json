{
  "name": "@dean_overlord/hesdor",
  "version": "0.1.0",
  "type": "module",
  "description": "Hesdor terminal UI and CLI entrypoint",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "hesdor": "./bin/hesdor.js"
  },
  "main": "./dist/bundle.js",
  "types": "./dist/cli.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/bundle.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild dist/cli.js --bundle --platform=node --format=esm --outfile=dist/bundle.js --external:ink --external:ink-text-input --external:react",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@hesdor/agent-core": "workspace:*",
    "@hesdor/protocol": "workspace:*",
    "@hesdor/providers": "workspace:*",
    "@types/react": "^19.2.18",
    "esbuild": "^0.28.2"
  }
}
