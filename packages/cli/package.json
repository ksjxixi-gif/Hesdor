{
  "name": "@hesdor/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "Hesdor terminal UI and CLI entrypoint",
  "license": "MIT",
  "bin": {
    "hesdor": "./bin/hesdor.js"
  },
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hesdor/agent-core": "workspace:*",
    "@hesdor/protocol": "workspace:*",
    "@hesdor/providers": "workspace:*",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18"
  }
}
