{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ksjxixi-gif/Hesdor/main/docs/config.schema.json",
  "title": "Hesdor config.json",
  "description": "User config (%APPDATA%/hesdor/config.json or ~/.config/hesdor/config.json). A project's .hesdor/config.json may only set mode, maxTokens, effort and model; other keys there are ignored with a warning.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "provider": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,39}$", "description": "Default provider preset or custom provider id. Not allowed in a project file." },
    "model": { "type": "string", "pattern": "^\\S+$", "description": "Legacy single default model; migrated into models on save. In a project file: the model for the provider you already use." },
    "models": {
      "type": "object",
      "description": "Default model per provider id.",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9._-]{0,39}$" },
      "additionalProperties": { "type": "string", "pattern": "^\\S+$" }
    },
    "mode": { "enum": ["build", "plan", "ask"], "description": "Interactive default mode." },
    "effort": { "enum": ["low", "medium", "high"], "description": "Default reasoning effort." },
    "maxTokens": { "type": "integer", "minimum": 1, "maximum": 1000000, "description": "Output token ceiling per model call (default 8192)." },
    "baseUrls": { "type": "object", "additionalProperties": { "type": "string" } },
    "customProviders": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["kind", "baseUrl"],
        "properties": {
          "kind": { "enum": ["openai", "openai-responses", "anthropic"] },
          "baseUrl": { "type": "string", "minLength": 1 },
          "authHeader": { "enum": ["x-api-key", "bearer"] },
          "apiKeyCommand": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "extraBody": { "type": "object" },
          "includeUsage": { "type": "boolean" }
        }
      }
    },
    "permissions": {
      "type": "object",
      "description": "run_command and file-write rules; deny beats ask beats allow.",
      "properties": {
        "allow": { "$ref": "#/$defs/rules" },
        "ask": { "$ref": "#/$defs/rules" },
        "deny": { "$ref": "#/$defs/rules" }
      },
      "additionalProperties": false
    },
    "updateCheck": { "type": "boolean" },
    "profile": { "enum": ["economy", "balanced", "frontier"], "description": "Picks the main model and unset roles from ranked candidates by which keys you have (docs/roles.md). Not allowed in a project file." },
    "escalate": { "type": "boolean", "description": "false: never switch a stuck run to roles.escalation. Default true." },
    "roles": {
      "type": "object",
      "properties": {
        "small": { "type": "string" },
        "subagent": { "type": "string" },
        "oracle": { "type": "string" },
        "fallback": { "type": "array", "items": { "type": "string" } },
        "escalation": { "type": "array", "items": { "type": "string" }, "description": "Stronger models, in order, for a stuck run; at most 2 switches per turn." }
      },
      "additionalProperties": false
    },
    "guardian": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" }, "model": { "type": "string" } },
      "additionalProperties": false
    },
    "checks": {
      "type": "object",
      "description": "Post-edit checks and the run_tests command, each an argv run without a shell; {file} is the edited file. Absent kinds are detected; [] turns one off.",
      "properties": {
        "format": { "$ref": "#/$defs/argv" },
        "lint": { "$ref": "#/$defs/argv" },
        "typecheck": { "$ref": "#/$defs/argv" },
        "test": { "$ref": "#/$defs/argv" },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 600000 }
      },
      "additionalProperties": false
    },
    "sandbox": {
      "type": "object",
      "description": "OS sandbox for run_command and background jobs (Linux bubblewrap, macOS Seatbelt; not Windows yet).",
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["off", "workspace-write", "read-only"] },
        "network": { "enum": ["off", "allowlist", "on"], "description": "Default off. allowlist is not enforced yet: the network stays off." },
        "allowDomains": { "type": "array", "items": { "type": "string" } },
        "failIfUnavailable": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "sessions": {
      "type": "object",
      "description": "Saved transcripts. Default: kept forever.",
      "properties": {
        "retainDays": { "type": "number", "exclusiveMinimum": 0, "description": "At startup, delete transcripts of every workspace not updated for this many days." }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "argv": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "rules": {
      "type": "array",
      "items": {
        "anyOf": [
          { "type": "string", "description": "Command prefix, e.g. \"git push\"." },
          { "type": "array", "items": { "type": "string" }, "description": "Command prefix as argv." },
          { "type": "object", "required": ["write"], "properties": { "write": { "type": "string" } }, "additionalProperties": false },
          { "type": "object", "required": ["fetch"], "properties": { "fetch": { "type": "string" } }, "additionalProperties": false }
        ]
      }
    }
  }
}
